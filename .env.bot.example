# Bot-only Telegram configuration.
BOT_TOKEN=
ADMINS=
ADMINS_OWNERS=
AUCTION_CHANNEL_ID=
AUCTION_CHANNEL_USERNAME=
DISCUSSION_CHAT_ID=
ADMIN_LOG_CHATS=
LOG_CHAT_ID=0
LUXURY_CHAT_ID=0
LUXURY_CHAT_ID_LVL2=0

# Bot database and identity secrets.
DATABASE_URL=postgresql://auction_bot:change_me@postgres:5432/auction_bot
DB_AUTO_MIGRATE=true
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
UID_HASH_KEY=
UID_ENC_KEY=
# Optional old Fernet key during a bounded re-encryption window.
UID_ENC_KEY_PREVIOUS=
RUNTIME_DIR=var

WINNER_NOTIFY_DEADLINE_MINUTES=5
BID_VALIDATION_MODE=userbot
USERBOT_BID_MODERATION=true
LOG_LEVEL=INFO
AIOGRAM_DEBUG=false
DEBUG_MW=false
DROP_PENDING_UPDATES=true

LEGACY_BRIDGE_SECRET=
LEGACY_BRIDGE_MAX_SKEW_SECONDS=300
LEGACY_BRIDGE_NONCE_CACHE_SIZE=4096

SUPERVISOR_ENABLED=false
SUPERVISOR_TOKEN=
SUPERVISOR_TOKEN_FILE=
SUPERVISOR_BASE_URL=
SUPERVISOR_CLIENT_TIMEOUT_SECONDS=20
SUPERVISOR_ACTOR=telegram-bot
