# Telegram
BOT_TOKEN=
ADMINS=
ADMINS_OWNERS=
AUCTION_CHANNEL_ID=
AUCTION_CHANNEL_USERNAME=
DISCUSSION_CHAT_ID=
ADMIN_LOG_CHATS=
LOG_CHAT_ID=
LUXURY_CHAT_ID=
LUXURY_CHAT_ID_LVL2=
ADMIN_CHAT=

# PostgreSQL. Для Compose DATABASE_URL должен обращаться к хосту postgres.
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=auction_bot
POSTGRES_USER=auction_bot
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://auction_bot:change_me@postgres:5432/auction_bot
DB_AUTO_MIGRATE=1
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5

# Telethon / userbot, если эти функции используются
TG_API_ID=
TG_API_HASH=
TG_SESSION=backfill.session
BACKFILL_LIMIT_POSTS=500
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION=var/userbot_session
RUNTIME_DIR=var

# Ежедневный Premium-анонс расписания на следующий день.
# Публикация включена, но не начнётся, пока через /schedule_emojis не сохранены
# обязательные custom emoji: header, card, diamond и tea.
SCHEDULE_ANNOUNCEMENTS_ENABLED=true
SCHEDULE_ANNOUNCEMENTS_HOUR=23
SCHEDULE_ANNOUNCEMENTS_MINUTE=0
SCHEDULE_ANNOUNCEMENTS_REQUIRE_CUSTOM_EMOJI=true
SCHEDULE_ANNOUNCEMENT_STATE_FILE=var/schedule_announcements.json

# UID-шифрование. Переноси существующие ключи, иначе старые UID нельзя будет расшифровать.
UID_HASH_KEY=
UID_ENC_KEY=

# Server Supervisor (Linux/VPS). Installer создаёт token-файл и dedicated group.
ROMATIC_DATA_DIR=/srv/romatic-club-max/server-data
SUPERVISOR_ENABLED=false
SUPERVISOR_TOKEN=
SUPERVISOR_TOKEN_FILE_HOST=/srv/romatic-club-max/server-data/runtime/supervisor/token
SUPERVISOR_BASE_URL=http://supervisor-proxy:8765
SUPERVISOR_CLIENT_TIMEOUT_SECONDS=20
SUPERVISOR_ACTOR=telegram-bot
ROMATIC_SUPERVISOR_NETWORK=romatic-supervisor-control
SERVER_SUPERVISOR_SOCKET_HOST=/srv/romatic-club-max/server-data/runtime/supervisor/romatic-server-supervisor.sock
SERVER_SUPERVISOR_SOCKET=/runtime/supervisor/romatic-server-supervisor.sock

# Дополнительные настройки
BID_VALIDATION_MODE=db
DROP_PENDING_UPDATES=1
LOG_LEVEL=INFO
