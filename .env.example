# Bot process: required Telegram credentials and destinations.
BOT_TOKEN=
ADMINS=
ADMINS_OWNERS=
AUCTION_CHANNEL_ID=
AUCTION_CHANNEL_USERNAME=
DISCUSSION_CHAT_ID=
ADMIN_LOG_CHATS=
LOG_CHAT_ID=0
LUXURY_CHAT_ID=0
LUXURY_CHAT_ID_LVL2=0

# Shared PostgreSQL configuration. In Compose, the host is "postgres".
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=auction_bot
POSTGRES_USER=auction_bot
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://auction_bot:change_me@postgres:5432/auction_bot
DB_AUTO_MIGRATE=true
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5

# Shared identity keys. Reuse deployed keys or old encrypted UIDs become unreadable.
UID_HASH_KEY=
UID_ENC_KEY=
RUNTIME_DIR=var
WINNER_NOTIFY_DEADLINE_MINUTES=5
BID_VALIDATION_MODE=userbot
USERBOT_BID_MODERATION=true

# Bot runtime.
LOG_LEVEL=INFO
AIOGRAM_DEBUG=false
DEBUG_MW=false
DROP_PENDING_UPDATES=true

# Optional authenticated legacy bridge.
LEGACY_BRIDGE_SECRET=
LEGACY_BRIDGE_MAX_SKEW_SECONDS=300
LEGACY_BRIDGE_NONCE_CACHE_SIZE=4096

# Userbot process. TG_* values are optional backfill overrides; USERBOT_* are required.
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION=var/userbot_session
TG_API_ID=
TG_API_HASH=
TG_SESSION=var/backfill
BACKFILL_LIMIT_POSTS=500

# Daily Premium schedule announcement.
SCHEDULE_ANNOUNCEMENTS_ENABLED=true
SCHEDULE_ANNOUNCEMENTS_HOUR=23
SCHEDULE_ANNOUNCEMENTS_MINUTE=0
SCHEDULE_ANNOUNCEMENTS_REQUIRE_CUSTOM_EMOJI=true
SCHEDULE_ANNOUNCEMENT_STATE_FILE=var/schedule_announcements.json

# Bot-side Supervisor client. Compose injects SUPERVISOR_TOKEN_FILE in the container.
SUPERVISOR_ENABLED=false
SUPERVISOR_TOKEN=
SUPERVISOR_TOKEN_FILE=
SUPERVISOR_BASE_URL=
SUPERVISOR_CLIENT_TIMEOUT_SECONDS=20
SUPERVISOR_ACTOR=telegram-bot

# Compose / host Supervisor deployment values. Python bot settings do not read these.
ROMATIC_DATA_DIR=/srv/romatic-club-max/server-data
SUPERVISOR_TOKEN_FILE_HOST=/srv/romatic-club-max/server-data/runtime/supervisor/token
ROMATIC_SUPERVISOR_NETWORK=romatic-supervisor-control
SERVER_SUPERVISOR_SOCKET_HOST=/srv/romatic-club-max/server-data/runtime/supervisor/romatic-server-supervisor.sock
SERVER_SUPERVISOR_SOCKET=/runtime/supervisor/romatic-server-supervisor.sock
