# Host/Compose configuration only. Application secrets live in .env.bot and .env.userbot.
POSTGRES_IMAGE=romatic-postgres:17-alpine-hardened
POSTGRES_DB=auction_bot
POSTGRES_USER=auction_bot
POSTGRES_PASSWORD=change_me

BOT_ENV_FILE=.env.bot
USERBOT_ENV_FILE=.env.userbot
ROMATIC_DATA_DIR=/srv/romatic-club-max/server-data
ROMATIC_APP_UID=10001
ROMATIC_APP_GID=10001

# Bot and userbot runtime boundaries.
BOT_MEMORY_LIMIT=512m
BOT_CPU_LIMIT=1.0
BOT_PIDS_LIMIT=256
BOT_STOP_GRACE_PERIOD=45s
USERBOT_MEMORY_LIMIT=512m
USERBOT_CPU_LIMIT=1.0
USERBOT_PIDS_LIMIT=256
USERBOT_STOP_GRACE_PERIOD=45s
ROMATIC_APPLICATION_NETWORK=romatic-application
ROMATIC_DATABASE_NETWORK=romatic-database

# Controlled database operations.
MIGRATION_RUNNER_MEMORY_LIMIT=512m
MIGRATION_RUNNER_CPU_LIMIT=1.0
RESTORE_DRILL_MEMORY_LIMIT=1g
RESTORE_DRILL_CPU_LIMIT=1.0
RESTORE_DRILL_TMPFS_SIZE=2g
# Contract migrations require an explicit bounded maintenance decision.
ROMATIC_ALLOW_CONTRACT_MIGRATION=false
# Optional mounted/off-host destination and AES-256-GCM key for encrypted archives.
ROMATIC_OFFSITE_BACKUP_DIR=
ROMATIC_BACKUP_ENCRYPTION_KEY_FILE=
ROMATIC_LOCAL_BACKUP_RETENTION_DAYS=14
ROMATIC_OFFSITE_BACKUP_RETENTION_DAYS=90

ROMATIC_SUPERVISOR_GID=10001
SUPERVISOR_TOKEN_FILE_HOST=/srv/romatic-club-max/server-data/runtime/supervisor/token
ROMATIC_SUPERVISOR_NETWORK=romatic-supervisor-control
SERVER_SUPERVISOR_SOCKET_HOST=/srv/romatic-club-max/server-data/runtime/supervisor/romatic-server-supervisor.sock
SERVER_SUPERVISOR_SOCKET=/runtime/supervisor/romatic-server-supervisor.sock
