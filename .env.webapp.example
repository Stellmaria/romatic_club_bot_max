# Keep this file separate from .env.bot in production so the web process receives
# only the secrets it actually needs.
BOT_TOKEN=
DATABASE_URL=postgresql://auction_bot:change_me@postgres:5432/auction_bot
DB_AUTO_MIGRATE=false
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5

# Access/status data used by the single auction-home screen.
LUXURY_CHAT_ID=
LUXURY_CHAT_ID_LVL2=
AUCTION_CHANNEL_USERNAME=
WEBAPP_LUXURY_CONTACT_URL=https://t.me/velassya

WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
WEBAPP_AUTH_MAX_AGE_SECONDS=3600
