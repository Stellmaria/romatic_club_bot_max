[Unit]
Description=Romatic Club encrypted off-host backup archive
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=%SERVICE_USER%
Group=%SERVICE_GROUP%
WorkingDirectory=%APP_DIR%
Environment=ROMATIC_APP_DIR=%APP_DIR%
Environment=ROMATIC_ENV_FILE=.env
Environment=ROMATIC_COMPOSE_FILE=compose.yaml
ExecStart=/usr/bin/env bash %APP_DIR%/deploy/server/archive-backups.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%DATA_DIR% %OFFSITE_DIR% /tmp
LockPersonality=true
RestrictSUIDSGID=true
